    {"name": "US47_filter_by_date",
     "steps": [
       {"url": "login", "data": {"email": "viewer@example.com", "password": "$PASSWORD"}, "expect": {"status": 200}},
       {"url": "auditlog-list", "method": "get", "auth": "admin", "params": {"date_from": "2000-01-01"},
        "expect": {"status": 200, "total_count": 1}},

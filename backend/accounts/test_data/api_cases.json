    {"name": "US46_delete_already_suspended_is_not_logged", "url": "user-detail", "args": ["@inactive"],
     "method": "delete", "auth": "admin",
     "expect": {"status": 204},
     "audit": [{"action": "user_suspend", "count": 0}]},

    {"name": "US46_reactivation_is_logged", "url": "user-detail", "args": ["@inactive"],
     "method": "patch", "auth": "admin", "data": {"is_active": true},
     "expect": {"status": 200},
     "audit": [{"action": "user_reactivate", "target_id": "@inactive", "count": 1}]},

    {"name": "US46_entries_cannot_be_modified_or_deleted_via_api",
     "steps": [
       {"url": "login", "data": {"email": "viewer@example.com", "password": "$PASSWORD"},
        "expect": {"status": 200}},
       {"url": "auditlog-list", "method": "get", "auth": "admin",
        "save": {"log_id": "results.0.id"}, "expect": {"status": 200, "results_count": 1}},
       {"url": "auditlog-detail", "args": ["$log_id"], "method": "patch", "auth": "admin",
        "data": {"action": "register"}, "expect": {"status": 405}},
       {"url": "auditlog-detail", "args": ["$log_id"], "method": "put", "auth": "admin",
        "data": {"action": "register"}, "expect": {"status": 405}},
       {"url": "auditlog-detail", "args": ["$log_id"], "method": "delete", "auth": "admin",
        "expect": {"status": 405},
        "audit": [{"action": "login_success", "count": 1}]}
     ]},


    {"name": "US47_list_anonymous_denied", "url": "auditlog-list", "method": "get",
     "expect": {"status": 401}},

    {"name": "US47_list_viewer_forbidden", "url": "auditlog-list", "method": "get", "auth": "viewer",
     "expect": {"status": 403}},

    {"name": "US47_list_analyst_forbidden", "url": "auditlog-list", "method": "get", "auth": "analyst",
     "expect": {"status": 403}},

    {"name": "US47_admin_can_list_paginated", "url": "auditlog-list", "method": "get", "auth": "admin",
     "expect": {"status": 200, "has_keys": ["count", "next", "previous", "results"], "total_count": 0}},

    {"name": "US47_list_is_read_only", "url": "auditlog-list", "auth": "admin",
     "data": {"action": "register"}, "expect": {"status": 405}},

    {"name": "US47_admin_can_retrieve_one_entry",
     "steps": [
       {"url": "login", "remote_addr": "203.0.113.9",
        "data": {"email": "viewer@example.com", "password": "$PASSWORD"}, "expect": {"status": 200}},
       {"url": "auditlog-list", "method": "get", "auth": "admin",

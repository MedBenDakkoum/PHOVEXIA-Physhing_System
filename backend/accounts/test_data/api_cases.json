    {"name": "US47_pagination",
     "steps": [
       {"url": "login", "data": {"email": "viewer@example.com", "password": "x1"}, "expect": {"status": 401}},
       {"url": "login", "data": {"email": "viewer@example.com", "password": "x2"}, "expect": {"status": 401}},
       {"url": "login", "data": {"email": "viewer@example.com", "password": "x3"}, "expect": {"status": 401}},
       {"url": "auditlog-list", "method": "get", "auth": "admin", "params": {"page_size": 2},
        "expect": {"status": 200, "results_count": 2, "total_count": 3, "has_keys": ["next"]}},

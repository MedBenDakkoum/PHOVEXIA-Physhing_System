SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE switch: sqlite (default, fast tests) or postgres (docker compose)
DB_ENGINE=sqlite
DB_NAME=phishing_db
DB_USER=phishing_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# --- Docker / Redis password -------------------------------------------
# Letters and digits only (it is embedded in REDIS_URL as `:password@`).
# - `docker compose up -d` (dev): redis starts WITH --requirepass as soon as
#   this key is non-empty, so REDIS_URL above must then contain the password
#   too (redis://:password@localhost:6379/0). Leave it empty to keep a
#   password-free dev redis.
# - `docker compose --profile full up`: REDIS_PASSWORD is REQUIRED (the
#   image entrypoint fails fast without it) and docker-compose.yml rewrites
#   REDIS_URL inside the containers to redis://:password@redis:6379/0.
REDIS_PASSWORD=phishing-ci

# Comma-separated browser origins accepted for CSRF (React dev server, nginx).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# --- Production security (all OFF by default = plain-HTTP local use) -----
# For an HTTPS deployment set ALL of them (see backend/deploy/README.md):
#   SECURE_SSL_REDIRECT=True
#   SECURE_HSTS_SECONDS=31536000
#   SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#   SECURE_HSTS_PRELOAD=True
#   SESSION_COOKIE_SECURE=True
#   CSRF_COOKIE_SECURE=True
# USE_X_FORWARDED_PROTO=True only behind a proxy that SETS X-Forwarded-Proto
# (docker-compose.yml sets it for nginx). An invalid value fails at startup.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=False

# Log level of the stdout handler (CRITICAL|ERROR|WARNING|INFO|DEBUG).
LOG_LEVEL=INFO

# Full Docker profile tuning.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=2

# Production mode (full Docker profile sets it automatically):
#   DJANGO_ENV=production  -> SECRET_KEY + ALLOWED_HOSTS REQUIRED (no default),
#                             DEBUG forced to False, entrypoint guard active.
# Leave unset/development for local work (DEBUG=True above).

# BR-01: max scans per user per calendar day (invalid values fall back to 20)
SCAN_DAILY_QUOTA=20

# Step 15 (ISO-6.5 reliability): a scan still ANALYZING/SUBMITTED after this
# many minutes is moved to FAILED by the beat task scans.reap_stuck_scans,
# and reported as stuck by GET /api/admin/health/. (Renamed from
# ANALYZING_STUCK_MINUTES, which was health-only.)
SCAN_STUCK_MINUTES=10

# Step 15 (retention): anonymous FAST scans (owner NULL, quick checks) older
# than this many days are deleted by the beat task scans.purge_expired_data.
# Audit entries keep the domain, never the URL.
QUICK_CHECK_RETENTION_DAYS=7

# CORS (Step 8c): comma-separated browser origins allowed cross-origin.
# Empty = same-origin only (no cross-origin request allowed).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Step 8d: DRF throttle rates on the auth endpoints.
# Format <count>/<period>, period starting with s, m, h or d.
# An invalid value is rejected at startup (ImproperlyConfigured).
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_REFRESH=60/min
THROTTLE_CHANGE_PASSWORD=5/hour

# Step 8d: reverse proxies in front of the API. 0 = the throttle key is
# REMOTE_ADDR only; a client-sent X-Forwarded-For is never trusted.
# The full Docker profile overrides this with NUM_PROXIES=1 (one proxy:
# nginx, which OVERWRITES X-Forwarded-For - see deploy/nginx.conf).
NUM_PROXIES=0

# Step 9 / BR-02: anonymous quick checks allowed per IP per hour
# (invalid values fall back to 5).
QUICK_CHECK_HOURLY_LIMIT=5

# Step 9: throttle on GET /api/quick-check/{uuid}/ (per IP).
# Production MUST use the Redis cache (REDIS_URL): LocMemCache counters are
# per process and would multiply the limit by the number of workers.
THROTTLE_QUICK_CHECK_DETAIL=60/min

# Step 13 (US5, US56, US57): email delivery. The default backend prints the
# emails to the console (no SMTP needed in development).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@phishing-detector.local

# Frontend base URL used in the password-reset link (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Validity of a password-reset token, in seconds (invalid values fall back
# to 3600).
PASSWORD_RESET_TIMEOUT=3600

# Step 13: password-reset throttles (format <count>/<period>, invalid values
# are rejected at startup).
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_RESET_CONFIRM=10/hour

# --- Inference service (US26, profile "full") ----------------------------
# Shared secret between the Celery worker and the inference container.
# The service refuses to start without it; /predict compares it in
# constant time (header X-API-Key). Required by docker compose.
INFERENCE_API_KEY=ci-inference-key-test
# Timeout of one /predict call, in seconds.
INFERENCE_TIMEOUT=30
# docker compose rewrites this to http://inference:8000 on the internal
# network (the port is never published). Set it only for local runs
# outside compose, e.g. http://127.0.0.1:8000.
INFERENCE_URL=http://localhost:8000

# --- Collector sandbox (US17 / US26, profile "full") -----------------------
# The Celery worker calls http://collector:8000 on collect_net (the collector
# publishes no port). Empty URL = not configured -> the real-bundle path
# fails closed with FAILED instead of calling a wrong endpoint.
COLLECTOR_URL=http://collector:8000
# Shared secret between the Celery worker and the collector (constant-time
# compare on the collector side, header X-API-Key). Required at startup.
COLLECTOR_API_KEY=
# Timeout of one /collect call, in seconds (fallback while the real pipeline
# is not configured).
COLLECTOR_TIMEOUT=30

# --- Media (screenshots) ----------------------------------------------------
# Where screenshots are written on disk (relative public path stored on the
# scan: screenshots/<public_id>.png).
MEDIA_ROOT=/app/media
# Screenshots (and their scan's file) older than this many days are deleted
# by the beat retention job (privacy, same spirit as quick checks).
SCREENSHOT_RETENTION_DAYS=30

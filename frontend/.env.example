# URL du backend Django utilisée par le proxy de développement (vite.config.js)
VITE_BACKEND_URL=http://127.0.0.1:8000

# URL de l'API utilisée par le navigateur.
# Laisser vide = même origine (/api/...), ce qui est recommandé :
#   - en dev, le proxy Vite relaie vers Django ;
#   - en prod, servez le front et l'API derrière le même domaine (nginx...).
# Si vous mettez une URL absolue, activez CORS côté Django (django-cors-headers).
VITE_API_URL=

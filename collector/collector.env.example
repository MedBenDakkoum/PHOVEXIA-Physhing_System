# Collector settings — copy to collector.env (gitignored) and edit.
# The ONLY secret the collector ever receives is COLLECTOR_API_KEY; the
# backend/.env database/JWT/inference secrets never reach this container.
COLLECTOR_API_KEY=replace-with-a-long-random-shared-secret
COLLECTOR_ENV=production
COLLECTOR_ALLOW_PRIVATE_HOSTS=
COLLECTOR_TIMEOUT_S=15
COLLECTOR_MAX_CONCURRENCY=2
COLLECTOR_BROWSER_RECYCLE_EVERY=50
COLLECTOR_MAX_TOTAL_BYTES=25000000
COLLECTOR_PROXY_PORT=3129
